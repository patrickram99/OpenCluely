# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: bill Gemini through Vertex AI (aiplatform.googleapis.com) on your
# Google Cloud project instead of the AI Studio key. Uses Application Default
# Credentials, so no API key is required in this mode. One-time setup:
#   gcloud auth application-default login
#   gcloud config set project <your-project-id>
#   gcloud services enable aiplatform.googleapis.com
# GEMINI_PROVIDER=vertex            # vertex | studio (default: studio)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global      # or a region such as us-central1
# Optional model override for either provider. Vertex default: gemini-3.8-flash
# (newest GA Flash). Fastest / no reasoning: gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.8-flash
# Optional reasoning level on Vertex (OFF | MINIMAL | LOW | MEDIUM | HIGH).
# Gemini 3.x: unset/OFF = MINIMAL on Flash-Lite, LOW on Flash/Pro (their floor).
# Gemini 2.x: OFF = budget 0, LOW = 1024, MEDIUM = 4096, HIGH = dynamic.
# GEMINI_THINKING_LEVEL=
# Overlay model preset (fast | balanced | power). Choosing one in the overlay
# rewrites GEMINI_MODEL and GEMINI_THINKING_LEVEL. See src/core/config.js.
# GEMINI_PRESET=fast

# Skill the overlay starts with: dsa (coding interviews) or aptitude
# (Wonderlic-style tests: answer first, one-line justification).
# ACTIVE_SKILL=dsa

# Keep a history of screenshot captures and answers in ~/.OpenCluely/captures/
# (<timestamp>.png + <timestamp>.md). Off by default.
# SAVE_CAPTURES=false

# Speech Recognition Configuration
# Choose one provider: azure or whisper
SPEECH_PROVIDER=whisper

# Optional: Azure Speech Services Configuration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Optional: Local OpenAI Whisper Configuration
# Requires a local Whisper CLI installation, for example:
#   pip install openai-whisper
#   brew install ffmpeg sox
# Use `whisper`, `python3 -m whisper`, or on Windows `.venv-whisper/Scripts/whisper.exe`
WHISPER_COMMAND=whisper
# Optional: where Whisper model weights are stored. Leave unset to use a stable
# app-data folder (recommended). Set an ABSOLUTE path to override; a relative
# path is ignored because it cannot be resolved reliably in packaged builds.
# WHISPER_MODEL_DIR=
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto
WHISPER_SEGMENT_MS=4000
WHISPER_DEVICE=auto
WHISPER_PYTHON=
WHISPER_CAPTURE_MODE=vad
WHISPER_RESPONSE_TARGET=both
WHISPER_MANUAL_MAX_MS=90000
WHISPER_GPU_IDLE_MS=60000
